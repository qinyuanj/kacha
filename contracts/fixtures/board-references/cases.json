    {
      "name": "不认识的节点类型：读不懂其字段，保守地把其中任何像任务目录路径或任务编号的字符串都算引用",
      "board": {
        "format_version": 1, "title": "a", "viewport": { "zoom": 1, "x": 0, "y": 0 }, "edges": [],
        "nodes": [
          { "id": "u", "type": "video", "pos": [0, 0], "size": [1, 1],
            "clips": [{ "src": "2026-04-04/20260404T040404Z-00000004/out.mp4" }, { "from_task": "20260405T050505Z-00000005" }],
            "note": "随便写的文字" },
          "2026-04-06/20260406T060606Z-00000006/x.png"
        ]
      },
      "expected": { "readable": true, "task_dirs": ["2026-04-04/20260404T040404Z-00000004", "2026-04-05/20260405T050505Z-00000005", "2026-04-06/20260406T060606Z-00000006"] }
    },
    {
      "name": "多个节点引用同一任务目录只列一次，按字典序",
      "board": {
        "format_version": 1, "title": "a", "viewport": { "zoom": 1, "x": 0, "y": 0 }, "edges": [],
        "nodes": [
          { "id": "r2", "type": "result", "pos": [0, 0], "size": [1, 1], "task_id": "20261001T000000Z-0000000b", "file": "result.png", "path": "2026-10-01/20261001T000000Z-0000000b/result.png", "layer_count": 0, "record": {} },
          { "id": "r1", "type": "result", "pos": [0, 0], "size": [1, 1], "task_id": "20260901T000000Z-0000000a", "file": "result.png", "path": "2026-09-01/20260901T000000Z-0000000a/result.png", "layer_count": 0, "record": {} },
          { "id": "x", "type": "reference", "pos": [0, 0], "size": [1, 1], "path": "2026-09-01/20260901T000000Z-0000000a/result.png", "sha256": "x", "display_name": "x" }
        ]
      },
      "expected": { "readable": true, "task_dirs": ["2026-09-01/20260901T000000Z-0000000a", "2026-10-01/20261001T000000Z-0000000b"] }
    },
    {
      "name": "版本更高的画板读不懂",
