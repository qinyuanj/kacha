      "expected": { "readable": true, "task_dirs": ["2026-11-06/20261106T080000Z-0000000a", "2026-11-06/20261106T080000Z-0000000b", "2026-11-06/20261106T080000Z-0000000c"] }
    },
    {
      "name": "提示词文本像路径也不算引用",
      "board": {
