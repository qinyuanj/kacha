        "nodes": [
          { "id": "p", "type": "prompt", "pos": [0, 0], "size": [1, 1], "text": "2026-01-01/20260101T000000Z-00000009/result.png" }
        ]
      },
      "expected": { "readable": true, "task_dirs": [] }
