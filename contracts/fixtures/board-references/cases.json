{
  "description": "画板文件 → 它引用的任务目录（相对用户数据根，<UTC 日期>/<task_id>）。服务端清理（server/src/references.rs）跑这组夹具。readable=false 表示画板读不懂（损坏 / 版本更高）：该用户本轮不清理，不能当成没有引用。",
  "cases": [
    {
      "name": "结果节点：path 与 task_id 指向同一任务目录",
      "board": {
        "format_version": 1, "title": "a", "viewport": { "zoom": 1, "x": 0, "y": 0 }, "edges": [],
        "nodes": [
          { "id": "r1", "type": "result", "pos": [0, 0], "size": [1, 1], "task_id": "20260916T091500Z-3f9c2a1b", "file": "result.png",
            "path": "2026-09-16/20260916T091500Z-3f9c2a1b/result.png", "layer_count": 2,
            "record": { "model": "m", "prompt": "", "negative_prompt": "", "size_spec": {}, "submitted_at": "2026-09-16T09:15:00Z",
                        "layers": [{ "file": "layers/01.png", "z_index": 0, "bounding_box": [0, 0, 1, 1] }] } }
        ]
      },
      "expected": { "readable": true, "task_dirs": ["2026-09-16/20260916T091500Z-3f9c2a1b"] }
    },
    {
      "name": "结果节点：path 在任务目录外时仍按 task_id 引用",
      "board": {
        "format_version": 1, "title": "a", "viewport": { "zoom": 1, "x": 0, "y": 0 }, "edges": [],
        "nodes": [
          { "id": "r1", "type": "result", "pos": [0, 0], "size": [1, 1], "task_id": "20260801T000000Z-00000001", "file": "result.png",
            "path": "导入参考图/abc.png", "layer_count": 0, "record": {} }
        ]
      },
      "expected": { "readable": true, "task_dirs": ["2026-08-01/20260801T000000Z-00000001"] }
    },
    {
      "name": "参考图节点：落在任务目录里的算引用，任务目录外与绝对路径不算",
      "board": {
        "format_version": 1, "title": "a", "viewport": { "zoom": 1, "x": 0, "y": 0 }, "edges": [],
        "nodes": [
          { "id": "a", "type": "reference", "pos": [0, 0], "size": [1, 1], "path": "2026-07-02/20260702T101010Z-0000abcd/result.png", "sha256": "x", "display_name": "a" },
          { "id": "b", "type": "reference", "pos": [0, 0], "size": [1, 1], "path": "导入参考图/0123.png", "sha256": "x", "display_name": "b" },
          { "id": "c", "type": "reference", "pos": [0, 0], "size": [1, 1], "path": "/home/someone/2026-07-03/x/y.png", "sha256": "x", "display_name": "c" },
          { "id": "d", "type": "reference", "pos": [0, 0], "size": [1, 1], "path": "C:\\Users\\a\\2026-07-04\\x\\y.png", "sha256": "x", "display_name": "d" }
        ]
      },
      "expected": { "readable": true, "task_dirs": ["2026-07-02/20260702T101010Z-0000abcd"] }
    },
    {
      "name": "非本工具编号的任务目录：只能靠 path 认出",
      "board": {
        "format_version": 1, "title": "a", "viewport": { "zoom": 1, "x": 0, "y": 0 }, "edges": [],
        "nodes": [
          { "id": "r", "type": "result", "pos": [0, 0], "size": [1, 1], "task_id": "legacy-42", "file": "result.png", "path": "2025-01-01/legacy-42/result.png", "layer_count": 0, "record": {} }
        ]
      },
      "expected": { "readable": true, "task_dirs": ["2025-01-01/legacy-42"] }
    },
    {
      "name": "任务节点：失败 / 已取消 / 已中断只靠 last_submitted.task_id 引用，快照图片的 task_id 与 path 也算",
      "board": {
        "format_version": 1, "title": "a", "viewport": { "zoom": 1, "x": 0, "y": 0 }, "edges": [],
        "nodes": [
          { "id": "t", "type": "task", "pos": [0, 0], "size": [1, 1], "model": "m", "size_spec": {}, "image_ports": 2,
            "layer_decomposition": false, "transparent_background": false,
            "last_submitted": {
              "task_id": "20260610T120000Z-deadbeef",
              "images": [
                { "kind": "result", "task_id": "20260601T000000Z-00000002", "file": "result.png", "source_layer": null, "region": null },
                { "kind": "reference", "path": "2026-05-20/20260520T000000Z-00000003/layers/01.png", "sha256": "x", "region": null },
                { "kind": "reference", "path": "导入参考图/zz.png", "sha256": "x", "region": null }
