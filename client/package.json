{
  "name": "kacha-client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:release": "python ../packaging/build_web.py",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint:dead": "knip && knip --production"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@xyflow/react": "^12.11.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^31.0.0",
    "knip": "^6.44.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
